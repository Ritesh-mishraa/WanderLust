<% layout("/layouts/boilerplate") %>

<style>
  #filters{
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    overflow-x: auto;
    gap: 1rem;
    padding: 0 1rem;
  }
  .col1{
    flex: 80%;
    display: flex;
    overflow-x: auto;
    gap: 1rem;
  }
  .filter{
    margin-top: 1rem;
    text-align: center;
    margin-right: 2rem;
    margin-top: 2rem;
    opacity: 0.7;
    flex-shrink: 0;
   }
   .filter:hover{
    opacity: 1;
    cursor: pointer;
   }
   .filter p{
    font-size: 0.8rem;
   }

   .tax-info{
    display: none;
   }
   .tax-toggle{
     flex-shrink: 0;
    white-space: nowrap;
    display: flex;
    align-items: center;
    padding: 0.5rem 1rem;
    border: 1px solid black;
    border-radius: 1rem;
    height: 3.25rem;
    margin-left: 1rem;
    min-width: max-content;
    font-size: 0.85rem;
  }
   .col1::-webkit-scrollbar {
      height: 6px;
  }
  .col1::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 10px;
  }
  @media (max-width: 576px) {
  .tax-toggle {
    padding: 0.3rem 0.6rem;
    font-size: 0.75rem;
    border-radius: 0.75rem;
  }

  .tax-toggle label {
    white-space: nowrap;
  }
}
  
</style>

<%= success %>
<div id="filters">
  <div class=" col1 d-flex flex-nowrap overflow-auto gap-3 category-scroll py-2 px-3">
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic City</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-fort-awesome"></i></div>
    <p>Castles</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-snowflake"></i></div>
    <p>Artic</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-snowflake"></i></div>
    <p>Arctic</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Domes</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-ship"></i></div>
    <p>Boats</p>
  </div>
  <div class="filter text-center flex-shrink-0">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </div>
  </div>


  <div class="tax-toggle ms-auto">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display Total after taxes</label>
    </div>
  </div>
</div>


<% if (searchQuery) { %>
  <h3>Search Results for "<%= searchQuery %>"</h3>
<% } %>

<% if (allListings.length === 0) { %>
  <div class="alert alert-warning mt-4" role="alert">
    ❌ Sorry, no places found for "<%= searchQuery %>".
  </div>
  <a href="/listings" class="btn btn-danger mt-2">Back to All Listings</a>
<% } %>


<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings){ %>
      <a href="/listings/<%=listing._id%>" class="listing-link">
        <div class="card col listing-card"  >
            <img src="<%=listing.image.url%>" class="card-img-top" alt="Listing_image"  style= "height: 20rem;"width: 20rem;>
            <div class="card-img-overlay">
                
            </div>
            <div class="card-body">
              <p class="card-text"><b><%= listing.title %></b> <br>
                &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
                <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
            </p>
            </div>
          </div>
      </a> 
         <% } %>
</div>



<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
      let taxInfo = document.getElementsByClassName("tax-info");
      for(info of taxInfo){
        if(info.style.display != "inline"){
        info.style.display = "inline";
      } else{
        info.style.display = "none";
      }
    }
  });
</script>


